<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>BENCH_FIXTURE_ORIGIN</key>
		<string>http://fixtures.firecrawl.test:8765</string>
		<key>FIRECRAWL_API_URL</key>
		<string>http://127.0.0.1:3012</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.localcrawler.heartbeat</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__CHECKOUT__/local-ops/run-heartbeat</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__CHECKOUT__/local-bench/var/com.localcrawler.heartbeat.err.log</string>
	<key>StandardOutPath</key>
	<string>__CHECKOUT__/local-bench/var/com.localcrawler.heartbeat.out.log</string>
	<key>StartInterval</key>
	<integer>7200</integer>
	<key>WorkingDirectory</key>
	<string>__CHECKOUT__</string>
</dict>
</plist>
